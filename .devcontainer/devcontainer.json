{
  "name": "legacy-modernization-agent sandbox",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "compose.yaml"
  ],
  "service": "workspace",
  "runServices": [
    "workspace",
    "db",
    "legacy",
    "ollama"
  ],
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && npm ci --prefix rag --no-audit --no-fund && npm ci --prefix mcp --no-audit --no-fund",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
